@model ShopTARpe25.Models.Library.LibraryCreateUpdateViewModel

@if (Model.Id != Guid.Empty)
{
    <h1>Book Update</h1>
}
else
{
    <h1>Book Create</h1>
}

<form method="post" enctype="multipart/form-data" class="book-form">
    <div>
        Book Details
    </div>

    <input type="hidden" asp-for="Id" />

    <div class="form-group row">
        <label asp-for="Title" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="Author" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Author" class="form-control" />
            <span asp-validation-for="Author" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="PublishedYear" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="PublishedYear" class="form-control" />
            <span asp-validation-for="PublishedYear" class="text-danger"></span>
        </div>
    </div>

    @* uus raamat on alati saadaval, seega checkbox ainult Update puhul *@
    @if (Model.Id != Guid.Empty)
    {
        <div class="form-group row">
            <label asp-for="IsAvailable" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="IsAvailable" class="form-check-input" type="checkbox" />
            </div>
        </div>
    }

    @if (Model.Id != Guid.Empty)
    {
        <div class="form-group row">
            <label asp-for="CreatedAt" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">@Html.DisplayFor(model => model.CreatedAt)</div>
        </div>

        <div class="form-group row">
            <label asp-for="ModifiedAt" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">@Html.DisplayFor(model => model.ModifiedAt)</div>
        </div>
    }

    <div class="form-group row">
        <label asp-for="Files" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-5">
            <input asp-for="Files" class="form-control" type="file" multiple />
        </div>
    </div>

    <div class="book-gallery">
        @foreach (var images in Model.Images)
        {
            <div class="book-image-item">
                <partial name="_Images" model="images" />
                <input asp-action="removeImage" asp-controller="library" asp-route-imageId="@images.ImageId"
                       type="submit" formnovalidate class="btn btn-danger btn-sm" value="Remove Image" />
            </div>
        }
    </div>

    <hr />

    @if (Model.Id != Guid.Empty)
    {
        <input asp-action="update" asp-controller="library" type="submit" class="btn btn-primary" value="Update" />
    }
    else
    {
        <input asp-action="create" asp-controller="library" type="submit" class="btn btn-primary" value="Create" />
    }

    <a asp-action="Index" asp-controller="library" class="btn btn-secondary">Back to List</a>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}