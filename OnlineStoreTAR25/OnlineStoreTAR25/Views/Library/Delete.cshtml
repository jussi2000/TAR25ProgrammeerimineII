@model ShopTARpe25.Models.Library.LibraryDeleteViewModel

<h1>Delete Book</h1>
<div>
    <h4>Book</h4>
    <hr />

    <dl class="row">
        <div class="form-group row">
            <label asp-for="Id" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">@Html.DisplayFor(model => model.Id)</div>
        </div>
    </dl>

    <dl class="row">
        <div class="form-group row">
            <label asp-for="Title" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">@Html.DisplayFor(model => model.Title)</div>
        </div>
    </dl>

    <dl class="row">
        <div class="form-group row">
            <label asp-for="Author" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">@Html.DisplayFor(model => model.Author)</div>
        </div>
    </dl>

    <dl class="row">
        <div class="form-group row">
            <label asp-for="PublishedYear" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">@Html.DisplayFor(model => model.PublishedYear)</div>
        </div>
    </dl>

    <dl class="row">
        <div class="form-group row">
            <label asp-for="IsAvailable" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">@Html.DisplayFor(model => model.IsAvailable)</div>
        </div>
    </dl>

    <dl class="row">
        <div class="form-group row">
            <label asp-for="CreatedAt" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">@Html.DisplayFor(model => model.CreatedAt)</div>
        </div>
    </dl>

    <dl class="row">
        <div class="form-group row">
            <label asp-for="ModifiedAt" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">@Html.DisplayFor(model => model.ModifiedAt)</div>
        </div>
    </dl>

    @foreach (var images in Model.Images)
    {
        <partial name="_Images" model="images" />
        <br />
    }

    <hr />
    <form asp-action="DeleteConfirmation">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" asp-controller="library" class="btn btn-secondary">Back to list</a>
    </form>
</div>