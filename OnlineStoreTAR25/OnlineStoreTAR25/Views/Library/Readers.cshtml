@model IEnumerable<ShopTARpe25.Core.Domain.Reader>

@* lugeja lisamine *@
<h2>Add Reader</h2>
<form asp-action="AddReader" asp-controller="Library" method="post" class="row g-2 mb-4">
    <div class="col-sm-4">
        <input name="fullName" class="form-control" placeholder="Full name" required />
    </div>
    <div class="col-sm-4">
        <input name="email" type="email" class="form-control" placeholder="Email" required />
    </div>
    <div class="col-sm-2">
        <input type="submit" value="Add" class="btn btn-primary" />
    </div>
</form>

<h2>Readers</h2>
@* otsing nime või e-posti järgi *@
<form method="get" asp-action="Readers" asp-controller="Library" class="row g-2 mb-3">
    <div class="col-sm-4">
        <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name or email" />
    </div>
    <div class="col-sm-3">
        <button type="submit" class="btn btn-secondary">Search</button>
        <a asp-action="Readers" asp-controller="Library" class="btn btn-link">Clear</a>
    </div>
</form>
<table class="table">
    <thead>
        <tr>
            <th>Nr</th>
            <th>Full Name</th>
            <th>Email</th>
            <th>Active loans</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @{
            int rownumber = 1;
        }
        @foreach (var reader in Model)
        {
            <tr>
                <td>@rownumber</td>
                <td>@reader.FullName</td>
                <td>@reader.Email</td>
                <td>@reader.Loans.Count(l => l.ReturnDate == null)</td>
                <td>
                    <a asp-action="ReaderLoans" asp-route-id="@reader.Id" class="btn btn-warning">Loans</a>
                    <form asp-action="DeleteReader" asp-controller="Library" asp-route-id="@reader.Id" method="post" class="d-inline">
                        <input type="submit" value="Delete" class="btn btn-danger" />
                    </form>
                </td>
            </tr>
            rownumber++;
        }
        @if (!Model.Any())
        {
            <tr><td colspan="5">No readers yet.</td></tr>
        }
    </tbody>
</table>