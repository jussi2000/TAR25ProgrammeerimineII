@model IEnumerable<ShopTARpe25.Models.Library.LibraryIndexViewModel>

@* Nupu tegemine *@
<div>
    <a asp-action="create" asp-controller="Library" class="btn btn-primary">Create</a>
</div>

@* Loendi kuvamine *@
<h2>Library Books</h2>
<table class="table">
    @* iga tulba pealkirjad *@
    <thead>
        <tr>
            <th>Nr</th>
            <th>Title</th>
            <th>Author</th>
            <th>Published Year</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @{
            int rownumber = 1; @* id Nr'id, loendus algab ühest *@
        }
        @foreach (var book in Model)
        {
            <tr>
                <td>@rownumber</td> @* järjekorranumber *@
                <td>@book.Title</td>
                <td>@book.Author</td>
                <td>@book.PublishedYear</td>
                <td>@(book.IsAvailable ? "Available" : "Borrowed")</td>
                <td>
                    @* Nupud: details, update, delete *@
                    <a asp-action="details" asp-route-id="@book.Id" class="btn btn-warning">Details</a>
                    <a asp-action="update" asp-route-id="@book.Id" class="btn btn-primary">Update</a>
                    <a asp-action="delete" asp-route-id="@book.Id" class="btn btn-danger">Delete</a>
                </td>
            </tr>
            rownumber++;
            @* iga uus rida on +1 id number *@
        }
    </tbody>
</table>