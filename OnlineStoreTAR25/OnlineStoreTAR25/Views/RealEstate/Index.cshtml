@model IEnumerable<ShopTARpe25.Models.RealEstate.RealEstateIndexViewModel>

<div>
<a asp-action="Create" class="btn btn-primary"> Create new real estate</a>
</div>

    <h2>Real estates</h2>

    <table class="table table-modern">
        <thead>
            <tr>
                <th>Nr</th>
                <th>Address</th>
                <th>Area</th>
                <th>Rooms</th>
                <th>Building type</th>
            </tr>
        </thead>
        <tbody>
            @{
                int rownumber = 1;
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td class="ps-4 text-muted">@rownumber</td>
                    <td class="fw-semibold">@item.Address</td>
                    <td>@item.Area</td>
                    <td>@item.RoomNumber</td>
                    <td>@item.BuildingType</td>
                    <td>
                    <a asp-action="details" asp-route-id="@item.Id" class="btn btn-warning">Details</a>
                    <a asp-action="update" asp-route-id="@item.Id" class="btn btn-primary">Update</a>
                    <a asp-action="delete"asp-route-id="@item.Id" class="btn btn-danger">Delete</a>
                    </td>
                </tr>
                rownumber++;
            }
        </tbody>
    </table>