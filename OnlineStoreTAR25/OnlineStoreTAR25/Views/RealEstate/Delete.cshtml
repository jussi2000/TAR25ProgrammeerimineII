@model ShopTARpe25.Models.RealEstate.RealEstateDeleteViewModel

<div class="page-header">
    <h2>Delete real estate</h2>
</div>

<div class="card-soft">
    <div class="alert alert-danger">Are you sure you want to delete <strong>@Model.Address</strong>?</div>

    <dl class="row info-list mb-0">
        <dt class="col-sm-3">Area</dt>
        <dd class="col-sm-9">@Model.Area</dd>
        <dt class="col-sm-3">Rooms</dt>
        <dd class="col-sm-9">@Model.RoomNumber</dd>
        <dt class="col-sm-3">Building type</dt>
        <dd class="col-sm-9">@Model.BuildingType</dd>
        <dt class="col-sm-3">Created at</dt>
        <dd class="col-sm-9">@Model.CreatedAt?.ToString("dd.MM.yyyy HH:mm")</dd>
        <dt class="col-sm-3">Modified at</dt>
        <dd class="col-sm-9">@Model.ModifiedAt?.ToString("dd.MM.yyyy HH:mm")</dd>
    </dl>

    <form asp-action="DeleteConfirmation" class="mt-4 d-flex gap-2">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>