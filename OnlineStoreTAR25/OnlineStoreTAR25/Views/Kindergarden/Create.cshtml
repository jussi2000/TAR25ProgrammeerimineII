@model ShopTARpe25.Models.Kindergarden.KindergardenCreateViewModel

<div class="container">
    <h2>
        Create</h2>
    <hr />

    <form method="post" enctype="multipart/form-data" asp-action="Create" asp-controller="Kindergarden">
        <div class="row">
            <div class="col-md-8">

                <div class="form-group mb-3">
                    <label asp-for="GroupName" class="col-form-label"></label>
                    <input asp-for="GroupName" class="form-control" />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="ChildrenCount" class="col-form-label"></label>
                    <input asp-for="ChildrenCount" class="form-control" />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="KindergartenName" class="col-form-label"></label>
                    <input asp-for="KindergartenName" class="form-control" />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="TeacherName" class="col-form-label"></label>
                    <input asp-for="TeacherName" class="form-control" />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Files" class="col-form-label">Upload images</label>
                    <input asp-for="Files" type="file" class="form-control" multiple />
                </div>

                <div class="mt-4">
                    <input asp-action="Create" asp-controller="Kindergarden" type="submit" class="btn btn-primary me-2" value="Create" />
                    <a asp-action="Index" asp-controller="Kindergarden" class="btn btn-secondary">Back to List</a>
                </div>

            </div>
        </div>
    </form>
</div>