@model ShopTARpe25.Models.Kindergarden.KindergardenUpdateViewModel

@* Update.cshtml *@
<div class="kg-update">

<h1>Update</h1>
<div>
    <form method="post" enctype="multipart/form-data" asp-action="Update" asp-controller="Kindergarden">
        <input asp-for="Id" type="hidden" />
        <input asp-for="CreatedAt" type="hidden" />
        <input asp-for="UpdatedAt" type="hidden" />

        <div class="form-group row mb-3">
            <label asp-for="GroupName" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="GroupName" class="form-control" />
            </div>
        </div>

        <div class="form-group row mb-3">
            <label asp-for="ChildrenCount" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="ChildrenCount" class="form-control" />
            </div>
        </div>

        <div class="form-group row mb-3">
            <label asp-for="KindergartenName" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="KindergartenName" class="form-control" />
            </div>
        </div>

        <div class="form-group row mb-3">
            <label asp-for="TeacherName" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="TeacherName" class="form-control" />
            </div>
        </div>

        <div class="form-group row mb-3">
            <label asp-for="Files" class="col-sm-2 col-form-label">Upload new images</label>
            <div class="col-sm-10">
                <input asp-for="Files" type="file" class="form-control" multiple />
            </div>
        </div>

        @if (Model.FilesToApiViewModels != null && Model.FilesToApiViewModels.Any())
        {
            <div class="form-group row mt-3">
                <label class="col-sm-2 col-form-label">Existing images</label>
                <div class="col-sm-10 d-flex flex-column gap-3">
                    @foreach (var image in Model.FilesToApiViewModels)
                    {
                        <div style="width: 200px;">
                            <img src="~/multipleFileUpload/@image.FileUrl" class="img-thumbnail" style="width: 200px; height: auto; object-fit: cover;" />
                            <a asp-action="RemoveImage" asp-controller="Kindergarden" asp-route-imageId="@image.ImageId" asp-route-kindergardenId="@Model.Id" class="btn btn-danger btn-sm mt-1 w-100">Remove Image</a>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="mt-3">
            <input asp-action="Update" asp-controller="Kindergarden"
                   type="submit" class="btn btn-success" value="Update" />

            <a asp-action="Index" asp-controller="Kindergarden" class="btn btn-secondary">Back to List</a>
        </div>

    </form>
</div>
</div>