@model IEnumerable<ShopTARpe25.Models.Kindergarden.KindergardenIndexViewModel>

@* Index.cshtml ühendame  *@
<div class="kg-index">

@* Nupu tegemine *@
<div>
    <a asp-action="Create"
           asp-controller="Kindergarden"
           class="btn btn-primary">
        Create
    </a>
</div>

<!--Kindergarden branch-->
@* Loendi kuvamine *@
<h2>Kindergarten</h2>

<table class="table">
    @* iga tulba pealkirjad *@
    <thead>
        <tr>
            <th>Nr</th>
            <th>GroupName</th>
            <th>Children Count</th>
            <th>Kindergarten Name</th>
            <th>TeacherName</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @{
            int rownumber = 1;
        }
        @foreach (var ship in Model)
        {
            <tr>
                <td>@rownumber</td>
                <td>@ship.GroupName</td>
                <td>@ship.ChildrenCount</td>
                <td>@ship.KindergartenName</td>
                <td>@ship.TeacherName</td>
                <td>
                    <a asp-action="Details"
                           asp-controller="Kindergarden"
                           asp-route-id="@ship.Id"
                           class="btn btn-warning">
                        Details
                    </a>

                    <a asp-action="Update"
                           asp-controller="Kindergarden"
                           asp-route-id="@ship.Id"
                           class="btn btn-primary">
                        Update
                    </a>

                    <a asp-action="Delete"
                           asp-controller="Kindergarden"
                           asp-route-id="@ship.Id"
                           class="btn btn-danger">
                        Delete
                    </a>
                </td>
            </tr>
            rownumber++;
        }
    </tbody>
</table>

</div>