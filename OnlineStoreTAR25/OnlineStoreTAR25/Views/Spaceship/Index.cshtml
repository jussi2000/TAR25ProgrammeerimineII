@model IEnumerable<ShopTARpe25.Models.Spaceship.SpaceshipIndexViewModel>

@* Nupu tegemine *@
<div>
    <a asp-action="Create"
           asp-controller="Spaceship"
           class="btn btn-primary">
        Create
    </a>
</div>

<!--Kindergarden branch-->

@* Loendi kuvamine *@
<h2>Kindergarten</h2>

<table class="table"> @* iga tulba pealkirjad *@
    <thead>
        <tr>
            <th>Nr</th>
            <th>GroupName</th>
            <th>Children Count</th>
            <th>Kindergarten Name</th>
            <th>TeacherName</th>
        </tr>
    </thead>
    <tbody>
        @{
            int rownumber = 1; @* id Nr'id, loendus algab ühest *@
        }
        @foreach (var ship in Model)
        {
            <tr>
                <td>@rownumber</td> @* järjekorranumber *@
                <td>@ship.GroupName</td>
                <td>@ship.ChildrenCount</td>
                <td>@ship.KindergartenName</td>
                <td>@ship.TeacherName</td>
                <td>
                    @* Nupud: details, edit, delete vvv *@
                    <a asp-action="Details"asp-route-id="@ship.Id"
                           class="btn btn-warning">Details
                    </a>

                    <a asp-action="Update"asp-route-id="@ship.Id"
                           class="btn btn-primary">Update
                    </a>

                    <a asp-action="Delete"asp-route-id="@ship.Id"
                        class="btn btn-danger">Delete
                    </a>
                </td>
            </tr>
            rownumber++; @* iga uus rida on +1 id number, ehk üks arv suurem *@
        }
    </tbody>
</table>