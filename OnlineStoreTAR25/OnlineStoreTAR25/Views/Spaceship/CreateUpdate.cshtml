@model ShopTARpe25.Models.Spaceship.SpaceshipCreateUpdateViewModel

@if (Model.Id.HasValue)
{
    <h1>Spaceship Update</h1>
}
else
{
    <h1>Spaceship Create</h1>
}

<form  method="post" enctype="multipart/form-data">
    <div>
        Spaceship Create
    </div>

    <div>
        <label asp-for="Name" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Name" class="form-control" />
        </div>
    </div>

    <div>
        <label asp-for="Classification" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Classification" class="form-control" />
        </div>
    </div>

    <div>
        <label asp-for="BuildDate" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="BuildDate" class="form-control" />
        </div>
    </div>

    <div>
        <label asp-for="Crew" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Crew" class="form-control" />
        </div>
    </div>

    <div>
        <label asp-for="EnginePower" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="EnginePower" class="form-control" />
        </div>
    </div>

    See koht on failide üleslaadimise vorm.
    <div class="form-group row">
        <label asp-for="Files" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-5">
            <input asp-for="Files" class="form-control" type="file" multiple />
        </div>
    </div>

    <div>
        @foreach (var images in Model.Image)
            {
                <partial name="_images" model="images" />
            <partial name="_Images" model="images" />
            <input asp-action="removeImage" asp-controller="spaceship" asp-route-imageId="@images.ImageId"
            type="submit" class="btn btn-danger" value="Remove Image" />
            }
        </div>

        <hr />

        @if (Model.Id.HasValue)
        {
        <input asp-action="update" asp-controller="spaceship" type="submit" class="btn btn-primary" value="Update" />
        }
        else
        {
             <input asp-action="create" asp-controller="spaceship" type="submit" class="btn btn-primary" value="Create" />
        }

    <a asp-action="Index" asp-controller="spaceship" class="btn btn-secondary">Back to List</a>

</form>